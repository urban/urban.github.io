{
  "name": "@urban/personal-website-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": {
    "catalog": {
      "@effect/platform-node": "4.0.5",
      "effect": "4.0.5",
      "typescript": "^7.0.2"
    },
    "packages": [
      "scratchpad",
      "scripts",
      "packages/*"
    ]
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset add",
    "check": "bun run lint && turbo run typecheck test",
    "clean": "bun --filter=scripts run clean",
    "dev": "turbo run dev",
    "lint": "oxfmt && oxlint",
    "postinstall": "effect-tsgo patch --oxlint",
    "release": "echo \"No release script\" && exit 0",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "version": "changeset version && bun install"
  },
  "dependencies": {},
  "devDependencies": {
    "@changesets/cli": "2.30.0",
    "@effect/tsgo": "0.56.0",
    "oxfmt": "0.42.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "turbo": "2.8.20",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">= 24.12.0"
  },
  "packageManager": "bun@1.3.5"
}
