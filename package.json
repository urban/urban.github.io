{
  "name": "@urban/personal-website-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "changeset": "changeset add",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "clean": "pnpm --filter scripts run clean",
    "dev": "pnpm --recursive --parallel --if-present run dev",
    "lint": "oxfmt && oxlint",
    "postinstall": "effect-tsgo patch --oxlint",
    "release": "echo \"No release script\" && exit 0",
    "test": "pnpm --recursive --if-present run test",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "version": "changeset version && pnpm install"
  },
  "dependencies": {},
  "devDependencies": {
    "@changesets/cli": "2.30.0",
    "@effect/tsgo": "0.68.1",
    "oxfmt": "0.42.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">= 24.12.0"
  },
  "packageManager": "pnpm@10.8.1",
  "pnpm": {
    "overrides": {
      "@effect/platform-node-shared": "4.1.4"
    }
  }
}
