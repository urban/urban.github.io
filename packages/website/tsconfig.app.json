{
  "$schema": "http://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "target": "ES2017",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "noEmit": true,
    "resolveJsonModule": true,
    "plugins": [
      {
        "name": "next"
      },
      {
        "name": "@effect/language-service",
        "diagnostics": false,
        "allowedUnstableApis": [
          "effect/FileSystem",
          "effect/Path",
          "effect/Graph",
          "effect/cli",
          "@effect/platform-node"
        ]
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "package.json"
  ],
  "exclude": ["node_modules", "scripts", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
