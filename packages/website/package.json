    "dev": "next dev",
    "predev": "bun run copy-assets",
    "lint": "oxfmt && oxlint",
    "serve": "serve out",
    "start": "next start",
    "prestart": "bun run copy-assets",
    "test": "bun test --preload ./test-preload.js",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@urban/build-graph": "workspace:*",
    "@urban/graph-view": "workspace:*",
