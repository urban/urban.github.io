    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "effect": "catalog:",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "3.0.1",
    "postcss": "8.5.31",
    "rehype-callouts": "2.2.0",
