{
  "name": "@apps/personal-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "prebuild": "bun run copy-assets",
    "check": "bun run lint && bun run typecheck && bun run test",
    "clean-assets": "bun ./scripts/clean-assets.ts",
