---
// oxlint-disable-next-line import/no-unassigned-import -- Load global styles.
import "@/styles/globals.css"
import { Footer } from "@/ui/Footer"
import { Header } from "@/ui/Header"
import { PageNavigationAnimation } from "@/ui/PageNavigationAnimation"
const { title = "Urban Faubion", description = "Urban Faubion's personal website." } = Astro.props
---
<!doctype html>
<html lang="en" class="antialiased optimize-legibility">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Urban Faubion</title>
    <link rel="preload" href="/fonts/inter-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline src="/preload-color-scheme.js"></script>
  </head>
  <body>
    <Header siteName="Urban Faubion" client:load />
    <main><slot /></main>
    <Footer siteName="Urban Faubion" client:load />
    <PageNavigationAnimation client:load />
  </body>
</html>
