---
import { RuntimeServer } from "@/lib/RuntimeServer"
import { publishedProjects } from "@/lib/projects"
import SiteLayout from "@/layouts/SiteLayout.astro"
import { Container } from "@/ui/Container"
import { Heading } from "@/ui/Heading"
import { Text } from "@/ui/Text"
import { HomeIntro } from "@/ui/HomeIntro"
import { ProjectList } from "@/ui/ProjectList"
import { ContactSection } from "@/ui/ContactSection"

const projects = await RuntimeServer.runPromise(publishedProjects)
---
<SiteLayout title="Home" layout="home" description="Urban Faubion builds software, design systems, and tools that make developers’ lives easier.">
  <div class="grid-surface">
    <Container>
      <HomeIntro />
      <section class="home-projects" aria-labelledby="projects-title">
        <Heading level={2} variant="section" id="projects-title">Projects</Heading>
        <Text>Tools and experiments in how we build software.</Text>
        <ProjectList projects={projects} />
      </section>
    </Container>
  </div>
  <ContactSection />
</SiteLayout>
