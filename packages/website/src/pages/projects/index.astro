---
import { Array, DateTime, Effect, flow, Order } from "effect"
import SiteLayout from "@/layouts/SiteLayout.astro"
import { RuntimeServer } from "@/lib/RuntimeServer"
import { Content } from "@/lib/services/Content"
import type { ContentService } from "@/lib/services/Content"
import { Container } from "@/ui/Container"
import { ComingSoon } from "@/ui/ComingSoon"
const projects = await RuntimeServer.runPromise(Effect.gen(function* () {
  const content: ContentService = yield* Content
  return yield* content.getProjects.pipe(Effect.map(flow(Array.filter(({ data }) => data.published ?? true), Array.sortBy(Order.flip(Order.mapInput(DateTime.Order, ({ data }) => data.updatedAt))))))
}))
---
<SiteLayout title="Projects" description="A collection of my projects, with links to repositories and demos.">
  <Container><div className="py-10">
    <h1 className="my-2 text-2xl font-semibold text-black dark:text-white">Projects</h1>
    <ul className="flex flex-col gap-4">
      {projects.length === 0 && <ComingSoon />}
      {projects.map(({ data, slug }) => <li><a href={`/projects/${slug}/`} className="relative group flex flex-nowrap py-3 px-4 pr-10 rounded-lg border border-black/15 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/5 transition-colors">
        <div className="flex flex-col flex-1"><strong>{data.title}</strong><span className="text-sm">{data.description}</span></div><span aria-hidden="true">→</span>
      </a></li>)}
    </ul>
  </div></Container>
</SiteLayout>
