---
import SiteLayout from "@/layouts/SiteLayout.astro"
import { RuntimeServer } from "@/lib/RuntimeServer"
import { publishedProjects } from "@/lib/projects"
import { Container } from "@/ui/Container"
import { Heading } from "@/ui/Heading"
import { ProjectList } from "@/ui/ProjectList"

const projects = await RuntimeServer.runPromise(publishedProjects)
---
<SiteLayout title="Projects" description="A collection of my projects, with links to repositories and demos.">
  <Container>
    <Heading level={1} variant="page">Projects</Heading>
    <ProjectList projects={projects} headingLevel={2} />
  </Container>
</SiteLayout>
