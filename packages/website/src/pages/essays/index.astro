---
import { Array, DateTime, Effect, Order, pipe } from "effect";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { RuntimeServer } from "@/lib/RuntimeServer";
import { Content } from "@/lib/services/Content";
import type { ContentService } from "@/lib/services/Content";
import { Container } from "@/ui/Container";
import { ContentCard } from "@/ui/ContentCard";
import { Heading } from "@/ui/Heading";
import { ComingSoon } from "@/ui/ComingSoon";
const essays = await RuntimeServer.runPromise(
    Effect.gen(function* () {
        const content: ContentService = yield* Content;
        return yield* content.getEssays.pipe(
            Effect.map((entries) =>
                pipe(
                    entries.filter(({ data }) => data.published ?? true),
                    Array.sortBy(
                        Order.flip(
                            Order.mapInput(
                                DateTime.Order,
                                ({ data }) => data.updatedAt,
                            ),
                        ),
                    ),
                    Array.groupBy(({ data }) =>
                        DateTime.toDateUtc(data.updatedAt)
                            .getUTCFullYear()
                            .toString(),
                    ),
                ),
            ),
        );
    }),
);
const years = Object.keys(essays).toSorted((a, b) => Number(b) - Number(a));
---

<SiteLayout
    title="Essays"
    description="A collection of essays on topics I am passionate about."
>
    <Container width="reading">
            <Heading level={1} variant="page">Essays</Heading>
            {years.length === 0 && <ComingSoon />}
            {years.map((year) => (
                <section class="essay-year" aria-label={year}>
                    <Heading level={2} variant="section">{year}</Heading>
                    <ul class="essay-list">
                        {essays[year]?.map(({ data, slug }) => (
                            <li>
                                <ContentCard
                                    variant="essay"
                                    title={data.title}
                                    description={data.description}
                                    date={data.updatedAt}
                                    href={`/essays/${slug}/`}
                                />
                            </li>
                        ))}
                    </ul>
                </section>
            ))}
    </Container>
</SiteLayout>
